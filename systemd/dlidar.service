# dLidar as the scanner's service: waits for the push button (docs/manual.html,
# "Running as a service"). Install: replace USER and REPO below, then
#   sudo cp systemd/dlidar.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now dlidar
[Unit]
Description=dLidar LiDAR scanner (push button recording, phone link)
Wants=network-online.target bluetooth.service
After=network-online.target bluetooth.service

[Service]
Type=simple
User=USER
# The button and LED lines (/dev/gpiochip*, group gpio); BlueZ over D-Bus for
# the phone link (upstream BlueZ allows only root and group bluetooth).
SupplementaryGroups=gpio bluetooth
WorkingDirectory=REPO
ExecStart=REPO/bin/dLidar
# SIGTERM saves a running recording before exiting; saving a 1 h Mid-360S
# recording takes ~20 min, so give it time.
KillSignal=SIGTERM
TimeoutStopSec=3600
# Restart after a crash, or when the sensor's network link was not up yet.
Restart=on-failure
RestartSec=5
# A private runtime directory: the Livox SDK configuration file and the phone
# link's socket /run/dlidar/dlidar.sock.
RuntimeDirectory=dlidar

[Install]
WantedBy=multi-user.target
