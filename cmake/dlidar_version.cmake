# Writes OUT (dlidar_version.h) with `git describe --always --dirty` of SRC,
# "unknown" without git. Rewritten only when the text changes, so a build
# without a new commit recompiles nothing. Run by the dlidar_version target
# on every build (cmake -P), not at configure time.
execute_process(COMMAND git describe --always --dirty WORKING_DIRECTORY ${SRC}
                OUTPUT_VARIABLE version OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE rc ERROR_QUIET)
if(NOT rc EQUAL 0 OR version STREQUAL "")
  set(version "unknown")
endif()
set(text "#pragma once\n// Generated by cmake/dlidar_version.cmake.\n#define DLIDAR_VERSION \"${version}\"\n")
if(EXISTS ${OUT})
  file(READ ${OUT} old)
endif()
if(NOT "${old}" STREQUAL "${text}")
  file(WRITE ${OUT} "${text}")
endif()
